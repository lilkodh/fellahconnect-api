@baseUrl = http://localhost:3000

##################################################
# FARMERS
##################################################

### Get all farmers
GET {{baseUrl}}/api/farmers

###

### Get farmer by id
GET {{baseUrl}}/api/farmers/1

###

### Create farmer
POST {{baseUrl}}/api/farmers
Content-Type: application/json

{
  "userId": 3,
  "firstName": "Ahmed",
  "lastName": "Benali",
  "address": "Agadir",
  "phone": "0612345678",
  "region": "Souss-Massa"
}

###

### Update farmer
PUT {{baseUrl}}/api/farmers/1
Content-Type: application/json

{
  "fullName": "Ahmed Updated",
  "phone": "0611111111",
  "region": "Souss-Massa"
}

###

### Delete farmer
DELETE {{baseUrl}}/api/farmers/1

